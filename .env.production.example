# Copia este archivo como .env en el servidor y sustituye TODOS los valores CAMBIAR_...
# No confirmes el archivo .env al repositorio.
SERVER_DOMAIN=CAMBIAR_POR_TU_DOMINIO.com
CADDY_EMAIL=admin@CAMBIAR_POR_TU_DOMINIO.com

MSSQL_PID=Express
MSSQL_SA_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SQL_LARGA_Y_UNICA
DB_NAME=gestionsalud
DB_USER=sa
DB_PASSWORD=CAMBIAR_POR_LA_MISMA_CLAVE_SQL
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=30000
DB_REQUEST_TIMEOUT_MS=30000
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY_MS=3000

REQUEST_BODY_LIMIT=50mb
CORS_ORIGINS=https://CAMBIAR_POR_TU_DOMINIO.com
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
JWT_EXPIRES_IN=24h
ALTCHA_HMAC_SECRET=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
SHARE_LINK_SECRET=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
SHARE_LINK_BASE=https://CAMBIAR_POR_TU_DOMINIO.com/api/v1/permiso-acceso/compartido

# La URL se inserta al compilar Expo Web y debe ser pública.
EXPO_PUBLIC_API_URL=https://CAMBIAR_POR_TU_DOMINIO.com
ALLOW_PUBLIC_USER_REGISTRATION=false
SEED_DEMO_USERS=false
# Genera un bcrypt de la contraseña y codifícalo en base64. Nunca uses los usuarios seed en producción.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=GUARDAR_EN_UN_GESTOR_DE_CONTRASENAS
INITIAL_ADMIN_PASSWORD_HASH_B64=CAMBIAR_POR_BCRYPT_EN_BASE64

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
NANO_UNLOCK_TIME_ZONE=America/Managua
PUSH_NOTIFICATIONS_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Gestion Salud <no-reply@CAMBIAR_POR_TU_DOMINIO.com>
