# ==========================================
# Configuración Docker Compose - Gestión Salud
# ==========================================

# 1. Gateway y Dominio Único (Puerto público)
GATEWAY_HTTP_PORT=80

# 2. Base de datos SQL Server
# Puerto expuesto en el HOST (14333 por defecto para no chocar con tus otras instancias de SQL Server en 1433)
MSSQL_EXTERNAL_PORT=14333
MSSQL_SA_PASSWORD=GestionSalud_2026!
MSSQL_PID=Developer

# Variables internas para los contenedores (comunicación interna en red Docker)
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=gestionsalud
DB_AUTH=sql
DB_USER=sa
DB_PASSWORD=GestionSalud_2026!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=30000
DB_REQUEST_TIMEOUT_MS=30000
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY_MS=3000

# 3. Backend NestJS
PORT=3000
REQUEST_BODY_LIMIT=10mb
# Permite tu subdominio o accesos locales
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://localhost:8081,http://localhost:3000

# Seguridad (mínimo 32 caracteres)
JWT_SECRET=super_secret_jwt_key_for_gestionsalud_2026_docker_at_least_32_chars
JWT_EXPIRES_IN=24h
ALLOW_PUBLIC_USER_REGISTRATION=true
ALTCHA_HMAC_SECRET=super_secret_altcha_hmac_key_for_gestionsalud_2026

# IA Nano (opcional para análisis de comidas con fotos)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
NANO_UNLOCK_TIME_ZONE=America/Managua

# Notificaciones y Correo
PUSH_NOTIFICATIONS_ENABLED=false
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Gestion Salud <no-reply@gestionsalud.local>"

# Enlaces compartidos
SHARE_LINK_BASE=http://localhost/api/v1/permiso-acceso/compartido
SHARE_LINK_SECRET=super_secret_share_link_key_2026

# 4. Aplicación Web / Expo
# Al usar el Gateway en el mismo dominio, la API se resuelve en /api o la raíz del host
EXPO_PUBLIC_API_URL=http://localhost/api
