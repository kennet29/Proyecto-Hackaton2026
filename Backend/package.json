{
  "name": "backend",
  "version": "1.0.0",
  "description": "api basica con nestjs para gestionar usuarios",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:debug": "ts-node-dev --respawn --inspect src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='\\.controller\\.spec\\.ts$' '\\.integration\\.spec\\.ts$' '\\.e2e-spec\\.ts$'",
    "test:controller": "jest --testMatch='**/*.controller.spec.ts'",
    "test:integration": "jest --testMatch='**/*.integration.spec.ts'",
    "test:e2e": "jest --testMatch='**/*.e2e-spec.ts' --runInBand",
    "test:watch": "jest --watch",
    "generate:modules": "node ./scripts/generate-modules.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^11.0.0",
    "altcha": "^3.2.1",
    "altcha-lib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "chrono-node": "^2.9.0",
    "morgan": "^1.10.1",
    "mssql": "^12.2.1",
    "nestjs-zod": "^5.2.1",
    "nodemailer": "^8.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "path-to-regexp": "^8.4.2"
  }
}
